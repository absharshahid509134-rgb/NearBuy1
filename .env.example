# ─── NearBuy environment (example — copy to .env.development / .env.production) ───
# Never commit real secrets. Server-only variables must NOT be prefixed with NEXT_PUBLIC_.

# Runtime
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://nearbuy:nearbuy@localhost:5432/nearbuy?schema=public

# Cache / queues
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=change-me-32-chars-minimum-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL_SECONDS=300

# Maps (MapProvider abstraction — Google adapter is optional)
MAPS_PROVIDER=haversine
MAPS_API_KEY=

# Payments (PaymentProvider abstraction — mock provider for dev)
PAYMENT_PROVIDER=mock
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Object storage (S3-compatible)
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Search (SearchProvider abstraction — SQL engine by default)
SEARCH_PROVIDER=sql
OPENSEARCH_URL=

# AI (LLM abstraction — grounded rule engine by default, never fabricates inventory)
AI_PROVIDER=grounded
AI_API_KEY=
AI_MODEL=

# Notifications (channels behind adapters)
EMAIL_API_KEY=
SMS_API_KEY=
WHATSAPP_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
