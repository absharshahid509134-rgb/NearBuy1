# NearBuy development environment — NEVER commit real secrets.
# Server-only variables must NOT be prefixed with NEXT_PUBLIC_.

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Embedded Postgres (scripts/dev-db.ts) — data in ./.pgdata
DATABASE_URL=postgresql://nearbuy:nearbuy@localhost:5432/nearbuy?schema=public

# Cache / queues (memory store when REDIS_URL is empty)
REDIS_URL=

# Auth
AUTH_SECRET=dev-only-nearbuy-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL_SECONDS=300

# Maps (MapProvider abstraction — haversine default, google optional)
MAPS_PROVIDER=haversine
MAPS_API_KEY=

# Payments (PaymentProvider abstraction — mock provider for dev)
PAYMENT_PROVIDER=mock
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Object storage (S3-compatible; local driver for dev)
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Search (SearchProvider abstraction — SQL engine by default)
SEARCH_PROVIDER=sql
OPENSEARCH_URL=

# AI (LLM abstraction — grounded rule engine by default, never fabricates inventory)
AI_PROVIDER=grounded
AI_API_KEY=
AI_MODEL=

# Notifications
EMAIL_API_KEY=
SMS_API_KEY=
WHATSAPP_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
